# Dependencies
/vendor/
/node_modules/
**/node_modules/

# Environment files
.env
.env.*
!.env.example

# Laravel generated files
/public/build/
/public/hot
/public/storage
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public/
!/storage/app/public/.gitignore
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore

# Cache and test output
/.phpunit.cache/
.phpunit.result.cache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build artifacts
/dist/
/build/
/.vite/
**/.vite/

# Local IDE/editor files
/.fleet/
/.idea/
/.vscode/
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Local auth/secrets
auth.json
*.pem
*.key

# Homestead
Homestead.json
Homestead.yaml
